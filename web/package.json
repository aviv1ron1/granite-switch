{
  "name": "granite-switch-web",
  "version": "0.1.0",
  "description": "Browser/Node runtime for Granite Switch via ONNX Runtime Web",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "validate": "node test/validate_node.mjs",
    "validate:tfjs": "node test/validate_tfjs.mjs",
    "validate:hub": "node test/validate_hub_repo.mjs",
    "validate:browser-path": "node test/validate_browser_path_node.mjs",
    "validate:native": "node --import ./test/hf-src-loader.mjs test/validate_native.mjs",
    "serve:coi": "python3 test/coi_server.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-web": "^1.20.0"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.26.0"
  }
}
